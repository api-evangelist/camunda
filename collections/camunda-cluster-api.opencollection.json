{
  "opencollection": "1.0.0",
  "info": {
    "name": "Camunda 8 REST Cluster API",
    "version": "8.6.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cluster",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get cluster topology",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/v2/topology"
          },
          "docs": "Returns the current topology of the Camunda cluster."
        }
      ]
    }
  ],
  "bundled": true
}