{
  "opencollection": "1.0.0",
  "info": {
    "name": "Camunda 8 REST Cluster Deployments API",
    "version": "8.6.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Deployments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Deploy resources",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/v2/deployments",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "resources",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Deploys BPMN processes, DMN decisions, and forms."
        },
        {
          "info": {
            "name": "Search deployments",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/v2/deployments/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search for deployments based on provided criteria."
        }
      ]
    }
  ],
  "bundled": true
}